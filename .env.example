# Copy this file to .env for reference, or (on Windows) edit server-settings.bat
# instead, which start.bat creates for you automatically on first run.
#
# This app doesn't read .env files automatically (no dependencies were used
# to keep it runnable with plain `node server.js`) - either export these in
# your shell/host platform's environment settings, or add a one-line loader
# yourself (e.g. `node -r dotenv/config server.js` if you install dotenv).

# Port the server listens on.
PORT=3000

# The very first account (role "owner") is created automatically the first
# time you run the server, using these two values. The owner can create
# admin, employee, and other owner accounts from the Admin panel afterwards -
# these two env vars are only used ONCE, on first boot.
OWNER_USERNAME=owner
OWNER_PASSWORD=change-me-to-a-strong-password

# Your UPI ID and the name shown to customers, used to build the "Pay
# Online" QR code with the correct amount for each order. Leave both blank
# to disable the online-payment QR (customers will be told to pay at the
# counter instead).
# These are only used to seed the setting the FIRST time the server ever
# starts - after that, change them from Admin > Global Settings > Payment
# Settings instead. Editing these env vars later won't do anything once
# data/config.json already has a value saved.
UPI_VPA=yourshop@upi
UPI_PAYEE_NAME=Seven Bits Coffee

# Set to 1 only once you're serving this over HTTPS - it makes the session
# cookie "Secure" (browsers won't send it over plain HTTP at all, which
# would lock you out if you're not on HTTPS yet).
FORCE_SECURE_COOKIE=0
